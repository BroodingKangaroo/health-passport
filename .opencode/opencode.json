{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git commit": "ask",
      "git am *": "ask",
      "git push *": "ask",
      "git pull *": "ask",
      "git reset *": "ask",
      "git checkout *": "ask",
      "git switch *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask",
      "git clean *": "ask",
      "git restore *": "ask",
      "git rm*": "ask",
      "git stash *": "ask",
      "git tag -d*": "ask",
      "git branch -D *": "ask",
      "git fetch --prune*": "ask",
      "rm -rf *": "ask",
      "rm -r *": "ask",
      "rm -f *": "ask",
      "rm *": "ask",
      "mv *": "ask",
      "pkill *": "ask",
      "sudo *": "ask",
      "chmod *": "ask",
      "python -m app.db.seed_loinc*": "ask",
      "*--regen-golden*": "ask"
    }
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 16384
  },
  "compaction": {
    "auto": true,
    "tail_turns": 6
  }
}