# Required: Mistral AI API key for OCR and LLM extraction
MISTRAL_API_KEY=

# Public base URL of the FRONTEND, used to build the links in outgoing email
# (password reset, email-change confirmation). Never derived from request
# headers — set it to the URL users actually open, e.g.
# https://app.healthpassport.example
FRONTEND_URL=http://localhost:3000

# Set to "production" in a real deployment. When SMTP is not configured,
# password-reset links are logged for local testing — but never when
# ENVIRONMENT=production (a logged one-time link is a live account takeover).
ENVIRONMENT=

# Transactional email (password reset + email change). With SMTP_ENABLED off
# (the default) nothing is sent and, outside production, the one-time link is
# written to the log instead — enough for local development.
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@healthpassport.local
# Transport security: starttls (submission port 587), ssl (implicit TLS, port
# 465 — several providers require it), or none (plaintext; also disables the
# guard below). Leave unset to use SMTP_TLS.
SMTP_SECURITY=starttls
# Legacy flag, still honoured when SMTP_SECURITY is unset: true → starttls,
# false → none. Credentials over an unencrypted connection are REFUSED unless
# the operator sets SMTP_SECURITY=none explicitly, so a forgotten flag fails
# closed instead of leaking the password.
SMTP_TLS=true
